# WordPress .gitignore
*.log
.htaccess
wp-config.php
wp-content/advanced-cache.php
wp-content/backup-db/
wp-content/backups/
wp-content/blogs.dir/
wp-content/cache/
wp-content/upgrade/
# wp-content/uploads/
wp-content/wp-cache-config.php
wp-content/plugins/
!wp-content/plugins/index.php

# Ignore all themes except our custom theme
# wp-content/themes/
# !wp-content/themes/index.php
# !wp-content/themes/dprd-purbalingga/

# Abaikan file compiler tailwind yang besar
wp-content/themes/dprd-purbalingga/tailwindcss.exe

# File koneksi / konfigurasi database lokal
test-db.php
*.local.php
config.php
database.php

# Kunci, Sertifikat, & Environment Variables
*.pem
*.key
.env
.env.*

# Folder besar & dependensi
node_modules/
vendor/
# Abaikan folder uploads secara default, tapi tetap izinkan file gambar (png, jpg, jpeg, webp)
wp-content/uploads/*
!wp-content/uploads/index.php
!wp-content/uploads/**/*.jpg
!wp-content/uploads/**/*.jpeg
!wp-content/uploads/**/*.png
!wp-content/uploads/**/*.webp

# OS generated files & cache
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db